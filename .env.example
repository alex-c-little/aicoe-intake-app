# Required: Lakebase Postgres connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@lakebase-host.cloud.databricks.com:5432/aicoe?sslmode=require

# Optional: Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me

# Optional: turn the progressive-enhancement JS layer on or off.
# When false, the app runs as a pure server-rendered HTML app (no drag-and-drop, no live filter).
ENABLE_JS_ENHANCEMENTS=true

# Optional: URL of your Databricks Genie space, used by the "Ask Genie" button.
# Example: https://YOUR-WORKSPACE.cloud.databricks.com/genie/rooms/abc123
GENIE_SPACE_URL=

# Optional: host/port overrides for `python app.py`.
HOST=127.0.0.1
PORT=8000
